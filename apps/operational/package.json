{
  "name": "@cmtcommand/operational",
  "version": "0.0.0",
  "private": true,
  "description": "CMTCommand Operational vNext scaffold shell.",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "node ../../contracts/cmtcommand-integration/v1/tests/contract-simulator.test.mjs && vitest run tests/unit/integration.cmt-event-contract.test.ts",
    "test:watch": "vitest",
    "test:db": "tsx scripts/db-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:contract && npm run build",
    "verify:db": "npm run db:migrate:test && npm run test:integration",
    "verify:full": "npm run verify && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "tsx scripts/db-migrate-test.ts",
    "db:studio": "drizzle-kit studio",
    "seed:identity:dev": "tsx scripts/seed-development-identities.ts",
    "seed:dispatch:dev": "npm run seed:identity:dev && tsx scripts/seed-dispatch-fixtures.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
