      "expected": { "accepted": 20, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "missing-or-expired-calibration" }
    },
    {
      "name": "dispatch cannot create or approve lab-owned technical results",
      "setupThroughIndex": 27,
      "events": [
        {
          "fromHappyIndex": 28,
          "overrides": {
            "eventId": "51515151-5151-4151-8151-515151515151",
            "sourceSystem": "CMTCommandOperational",
            "actorId": "dispatch-amy",
            "actorRole": "dispatcher",
            "idempotencyKey": "idem-dispatch-approve-lab-result"
          }
        }
      ],
      "expected": { "accepted": 28, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "forbidden-lab-approver" }
    },
    {
      "name": "dispatch cannot mutate approved lab result through operational status",
      "setupThroughIndex": 28,
      "events": [
        {
          "fromHappyIndex": 33,
          "overrides": {
            "eventId": "52525252-5252-4252-8252-525252525252",
            "idempotencyKey": "idem-dispatch-lab-mutation-attempt",
            "payload": {
              "status": "attempted_lab_result_edit",
              "reason": "negative test",
              "attemptedLabResultMutation": true
            }
          }
        }
      ],
      "expected": { "accepted": 29, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "dispatch-lab-result-mutation" }
    },
    {
      "name": "approved result cannot be overwritten",
      "setupThroughIndex": 28,
      "events": [
        {
          "fromHappyIndex": 28,
          "overrides": {
            "eventId": "53535353-5353-4353-8353-535353535353",
            "idempotencyKey": "idem-overwrite-approved-result",
            "revision": 8
          }
        }
      ],
      "expected": { "accepted": 29, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "approved-result-immutable" }
    },
    {
      "name": "approved result amendment is append only",
      "setupThroughIndex": 28,
      "events": [
        {
          "fromHappyIndex": 28,
          "overrides": {
            "eventId": "54545454-5454-4454-8454-545454545454",
            "eventType": "LabResultAmended",
            "actorId": "approver-kim",
            "actorRole": "lab_approver",
            "revision": 8,
            "idempotencyKey": "idem-approved-result-amended-sp-trd-104-a-02",
            "supersedesEventId": "26262626-2626-4626-8626-262626262626",
            "payload": {
              "resultEventId": "23232323-2323-4323-8323-232323232323",
              "approvedEventId": "26262626-2626-4626-8626-262626262626",
              "amendedAt": "2026-08-19T14:00:00.000Z",
              "amendedBy": "approver-kim",
              "amendmentReason": "Corrected report note; measured value unchanged.",
              "correctedFields": {
                "reportNote": "Corrected curing note from field box to moist room after receipt."
              }
            }
          }
        }
      ],
      "expected": { "accepted": 30, "duplicates": 0, "rejected": 0, "deadLettered": 0, "amendments": 1, "approvedStrength": 4956 }
    },
    {
      "name": "cross-organization access is rejected",
      "setupThroughIndex": 0,
      "events": [
        {
          "fromHappyIndex": 1,
          "overrides": {
            "eventId": "55555555-5555-4555-8555-555555555556",
            "organizationId": "org-beta-testing",
            "officeId": "office-fairfax",
            "idempotencyKey": "idem-cross-org-assignment"
          }
        }
      ],
      "expected": { "accepted": 1, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "cross-organization-access" }
    },
    {
      "name": "cross-office access is rejected unless explicitly authorized",
      "setupThroughIndex": 0,
      "events": [
        {
          "fromHappyIndex": 1,
          "overrides": {
            "eventId": "56565656-5656-4656-8656-565656565656",
            "officeId": "office-richmond",
            "idempotencyKey": "idem-cross-office-assignment"
          }
        }
      ],
