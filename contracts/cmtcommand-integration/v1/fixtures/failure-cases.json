    },
    {
      "name": "network outage keeps outbox item and retry acknowledges once",
      "outbox": {
        "networkPlan": ["offline", "offline", "online"],
        "eventFromHappyIndex": 0
      },
      "expected": { "attempts": 3, "accepted": 1, "queuedAfterOfflineAttempts": 2 }
    }
  ]
}
