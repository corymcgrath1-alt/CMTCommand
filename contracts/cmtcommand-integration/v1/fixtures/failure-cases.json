      "expected": { "accepted": 6, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "result-before-lab-receipt" }
    },
    {
      "name": "lab receipt before custody transfer is rejected",
      "setupThroughIndex": 5,
      "events": [
        {
          "fromHappyIndex": 15,
          "overrides": {
            "eventId": "48484848-4848-4848-8848-484848484848",
            "idempotencyKey": "idem-lab-receipt-before-custody",
            "revision": 2
          }
        }
      ],
      "expected": { "accepted": 6, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "out-of-order-custody" }
    },
    {
      "name": "missing or expired calibration evidence is rejected",
      "setupThroughIndex": 19,
      "events": [
        {
          "fromHappyIndex": 20,
          "overrides": {
            "eventId": "49494949-4949-4949-8949-494949494949",
            "idempotencyKey": "idem-expired-calibration-result",
            "payload": {
              "resultKind": "original_destructive",
              "testedAt": "2026-07-28T15:12:00.000Z",
              "breakAgeDays": 7,
              "measuredDimensions": {
                "diameter": { "value": 4.01, "unit": "in" },
                "height": { "value": 8.02, "unit": "in" }
              },
              "crossSectionalArea": { "value": 12.63, "unit": "sq in" },
              "maximumLoad": { "value": 40250, "unit": "lbf" },
              "compressiveStrength": { "value": 3187, "unit": "psi" },
              "fractureType": "type 2",
              "testingTechnician": "lab-tech-owen",
              "testingMachine": {
                "equipmentId": "PRESS-DC-02",
                "calibrationReference": "CAL-PRESS-DC-02-2026-01",
                "calibrationStatus": "current",
                "calibratedAt": "2026-01-01T12:00:00.000Z",
                "expiresAt": "2026-07-01T12:00:00.000Z"
              },
              "methodReferences": [
                { "identifier": "ASTM C39", "title": "Compressive Strength of Cylindrical Concrete Specimens" }
              ],
