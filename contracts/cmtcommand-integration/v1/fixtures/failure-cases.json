              "evidenceReferences": [
                { "evidenceId": "EV-EXPIRED-CAL", "evidenceType": "lab_machine_reading", "provenance": "PRESS-DC-02 raw reading", "capturedAt": "2026-07-28T15:12:00.000Z" }
              ]
            }
          }
        }
