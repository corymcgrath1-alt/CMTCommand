{
  "name": "cmtcommand-integration-v1-failure-fixtures",
  "description": "Negative fixtures are materialized by applying overrides to the happy-path events so examples stay aligned with the canonical event vocabulary.",
  "scenarios": [
    {
      "name": "duplicate event is acknowledged once",
      "events": [
        { "fromHappyIndex": 0 },
        { "fromHappyIndex": 0 }
      ],
      "expected": { "accepted": 1, "duplicates": 1, "rejected": 0, "deadLettered": 0 }
    },
    {
      "name": "conflicting idempotency key is rejected",
      "events": [
        { "fromHappyIndex": 0 },
        {
          "fromHappyIndex": 0,
          "overrides": {
            "eventId": "41414141-4141-4141-8141-414141414141",
            "workOrderId": "WO-IDEMPOTENCY-CONFLICT",
            "projectId": "PRJ-IDEMPOTENCY-CONFLICT",
            "payload": {
              "projectName": "Idempotency Conflict",
              "serviceType": "Concrete compression testing",
              "placementLocation": "Conflict deck",
              "readinessRequirements": ["assignment"]
            }
          }
        }
      ],
      "expected": { "accepted": 1, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "idempotency-conflict" }
    },
    {
      "name": "stale assignment revision is rejected",
      "setupThroughIndex": 1,
      "events": [
        {
          "fromHappyIndex": 2,
          "overrides": {
            "eventId": "42424242-4242-4242-8242-424242424242",
            "idempotencyKey": "idem-stale-assignment-accepted",
            "revision": 1
          }
        }
      ],
      "expected": { "accepted": 2, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "stale-revision" }
    },
    {
      "name": "four-cylinder fixture rejects specimenCount on a specimen event",
      "events": [
        { "fromHappyIndex": 0 },
        { "fromHappyIndex": 1 },
        { "fromHappyIndex": 2 },
        { "fromHappyIndex": 3 },
        { "fromHappyIndex": 4 },
        {
          "fromHappyIndex": 5,
          "overrides": {
            "eventId": "43434343-4343-4343-8343-434343434343",
            "idempotencyKey": "idem-invalid-specimen-count",
            "payload": {
              "specimenLabel": "TRD-104-A-BAD",
              "specimenKind": "concrete_cylinder",
              "specimenCount": 4,
              "dimensions": {
                "diameter": { "value": 4, "unit": "in" },
                "height": { "value": 8, "unit": "in" }
              },
              "curingMethod": "field box initial cure",
              "moldedAt": "2026-07-21T11:45:00.000Z",
              "createdAt": "2026-07-21T11:45:00.000Z"
            }
          }
        }
      ],
      "expected": { "accepted": 5, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "schema-validation" }
    },
    {
      "name": "reusing one specimen for 7-day and 28-day destructive results is rejected",
      "setupThroughIndex": 22,
      "events": [
        {
          "fromHappyIndex": 25,
          "overrides": {
            "eventId": "44444444-4444-4444-8444-444444444445",
            "idempotencyKey": "idem-reuse-tested-specimen-for-28-day",
            "specimenId": "SP-TRD-104-A-01",
            "revision": 8,
            "payload": {
              "resultKind": "original_destructive",
              "testedAt": "2026-08-18T15:18:00.000Z",
              "breakAgeDays": 28,
              "measuredDimensions": {
                "diameter": { "value": 4.0, "unit": "in" },
                "height": { "value": 8.01, "unit": "in" }
              },
              "crossSectionalArea": { "value": 12.57, "unit": "sq in" },
              "maximumLoad": { "value": 62300, "unit": "lbf" },
              "compressiveStrength": { "value": 4956, "unit": "psi" },
              "fractureType": "type 3",
              "testingTechnician": "lab-tech-owen",
              "testingMachine": {
                "equipmentId": "PRESS-DC-02",
                "calibrationReference": "CAL-PRESS-DC-02-2026-07",
                "calibrationStatus": "current",
                "calibratedAt": "2026-07-01T12:00:00.000Z",
                "expiresAt": "2026-12-31T12:00:00.000Z"
              },
              "methodReferences": [
                { "identifier": "ASTM C39", "title": "Compressive Strength of Cylindrical Concrete Specimens" }
              ],
              "validationStatus": "recorded",
              "evidenceReferences": [
                { "evidenceId": "EV-REUSED-PRESS-READING", "evidenceType": "lab_machine_reading", "provenance": "PRESS-DC-02 raw reading", "capturedAt": "2026-08-18T15:18:00.000Z" }
              ]
            }
          }
        }
      ],
      "expected": { "accepted": 23, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "specimen-already-tested" }
    },
    {
      "name": "reusing a specimen for conflicting break schedules is rejected",
      "setupThroughIndex": 23,
      "events": [
        {
          "fromHappyIndex": 23,
          "overrides": {
            "eventId": "45454545-4545-4545-8545-454545454545",
            "idempotencyKey": "idem-conflicting-break-schedule",
            "revision": 5,
            "payload": {
              "breakAgeDays": 56,
              "scheduledFor": "2026-09-15T15:00:00.000Z",
              "destructiveTest": true,
              "methodReferences": [
                { "identifier": "ASTM C39", "title": "Compressive Strength of Cylindrical Concrete Specimens" }
              ]
            }
          }
        }
      ],
      "expected": { "accepted": 24, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "specimen-break-already-scheduled" }
    },
    {
      "name": "result for an unknown specimen is rejected",
      "setupThroughIndex": 0,
      "events": [
        {
          "fromHappyIndex": 20,
          "overrides": {
            "eventId": "46464646-4646-4646-8646-464646464646",
            "idempotencyKey": "idem-unknown-specimen-result",
            "specimenId": "SP-UNKNOWN",
            "testSetId": "TS-UNKNOWN",
            "revision": 1
          }
        }
      ],
      "expected": { "accepted": 1, "duplicates": 0, "rejected": 1, "deadLettered": 0, "lastCode": "unknown-specimen" }
    },
    {
      "name": "result before lab receipt is rejected",
      "setupThroughIndex": 5,
      "events": [
        {
          "fromHappyIndex": 20,
          "overrides": {
            "eventId": "47474747-4747-4747-8747-474747474747",
            "idempotencyKey": "idem-result-before-lab-receipt",
